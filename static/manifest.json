{
  "manifest_version": 3,
  "name": "PR Auto Approve",
  "version": "1.0.0",
  "description": "Automatically approves GitHub pull requests when you open the Files changed page.",
  "minimum_chrome_version": "121",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "autoapprove@ready4god2513.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity"]
      }
    },
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PR Auto Approve settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
